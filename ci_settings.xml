<?xml version="1.0" encoding="utf-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">
<mirrors>
	<mirror>
	<id>biosamples-v4</id>
	<mirrorOf>biosamples-v4</mirrorOf>
	<url>https://gitlab.ebi.ac.uk/api/v4/projects/2669/packages/maven</url>
	</mirror>
	<mirror>
	<id>gitlab-maven</id>
	<mirrorOf>gitlab-maven</mirrorOf>
	<url>https://gitlab.ebi.ac.uk/api/v4/projects/1143/packages/maven</url>
	</mirror>
	<mirror>
	<id>gitlab-biosamples-search</id>
	<mirrorOf>gitlab-biosamples-search</mirrorOf>
	<url>https://gitlab.ebi.ac.uk/api/v4/projects/5516/packages/maven</url>
	</mirror>
</mirrors>
<servers>
	<server>
	<id>biosamples-v4</id>
	<configuration>
		<httpHeaders>
		<property>
			<name>Private-Token</name>
			<value>${env.GITLAB_MAVEN_TOKEN}</value>
		</property>
		</httpHeaders>
	</configuration>
	</server>
	<server>
	<id>gitlab-maven</id>
	<configuration>
		<httpHeaders>
		<property>
			<name>Private-Token</name>
			<value>${env.GITLAB_MAVEN_TOKEN}</value>
		</property>
		</httpHeaders>
	</configuration>
	</server>
	<server>
	<id>gitlab-biosamples-search</id>
	<configuration>
		<httpHeaders>
		<property>
			<name>Private-Token</name>
			<value>${env.GITLAB_MAVEN_TOKEN}</value>
		</property>
		</httpHeaders>
	</configuration>
	</server>
</servers>
<profiles>
	<profile>
	<id>embl-ebi</id>
	<repositories>
		<repository>
		<id>gitlab-maven</id>
		<url>https://gitlab.ebi.ac.uk/api/v4/projects/1143/packages/maven</url>
		</repository>
		<repository>
		<id>biosamples-v4</id>
		<url>https://gitlab.ebi.ac.uk/api/v4/projects/2669/packages/maven</url>
		</repository>
		<repository>
		<id>gitlab-biosamples-search</id>
		<url>https://gitlab.ebi.ac.uk/api/v4/projects/5516/packages/maven</url>
		</repository>
		<repository>
		<id>central</id>
		<name>Central Repository</name>
		<url>https://repo.maven.apache.org/maven2</url>
		<layout>default</layout>
		<snapshots>
			<enabled>false</enabled>
		</snapshots>
		</repository>
		<repository>
		<id>oracle-public</id>
		<url>https://maven.oracle.com/public</url>
		</repository>
	</repositories>
	</profile>
</profiles>
<activeProfiles>
	<activeProfile>embl-ebi</activeProfile>
</activeProfiles>
</settings>
